{
  "config": {
    "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/v0.41.1/schema/markdownlint-config-schema.json",
    "code-block-style": {
      "style": "fenced"
    },
    "line-length": false,
    "no-duplicate-heading": {
      "siblings_only": true
    },
    "no-emphasis-as-heading": true,
    "no-inline-html": {
      "allowed_elements": [
        "details",
        "summary",
        "kbd",
        "img",
        "code"
      ],
      "table_allowed_elements": [
        "br"
      ]
    },
    "table-column-style": {
      "style": "compact"
    }
  },
  "gitignore": true,
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "nginx-upstream-healthcheck/ngx_http_upstream_healthcheck_module/**"
  ]
}
