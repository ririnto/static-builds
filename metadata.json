{
  "nginx": {
    "tag_prefix": "nginx",
    "release_files": ["sbin/nginx"],
    "env": {
      "ALPINE_VERSION": "3.23.8",
      "NGINX_VERSION": "1.30.7",
      "NGINX_VTS_MODULE_VERSION": "0.2.7",
      "CENTOS_VERSION": "7.9.2009",
      "UBI10_MINIMAL_VERSION": "10.3-1795002774",
      "NJS_VERSION": "1.0.2",
      "QUICKJS_VERSION": "0.18.0"
    },
    "downloads": [
      {
        "url": "https://nginx.org/download/nginx-{NGINX_VERSION}.tar.gz",
        "name": "nginx-{NGINX_VERSION}.tar.gz"
      },
      {
        "url": "https://github.com/vozlt/nginx-module-vts/archive/refs/tags/v{NGINX_VTS_MODULE_VERSION}.tar.gz",
        "name": "nginx-module-vts-{NGINX_VTS_MODULE_VERSION}.tar.gz"
      },
      {
        "url": "https://github.com/nginx/njs/archive/refs/tags/{NJS_VERSION}.tar.gz",
        "name": "njs-{NJS_VERSION}.tar.gz"
      },
      {
        "url": "https://github.com/quickjs-ng/quickjs/archive/refs/tags/v{QUICKJS_VERSION}.tar.gz",
        "name": "quickjs-{QUICKJS_VERSION}.tar.gz"
      }
    ],
    "version_env_var": "NGINX_VERSION"
  },
