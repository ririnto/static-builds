        "url": "https://github.com/quickjs-ng/quickjs/archive/refs/tags/v{QUICKJS_VERSION}.tar.gz",
        "name": "quickjs-{QUICKJS_VERSION}.tar.gz"
      }
    ],
    "version_env_var": "NGINX_VERSION"
  },
  "haproxy": {
    "tag_prefix": "haproxy",
    "release_files": ["sbin/haproxy"],
    "env": {
      "ABSEIL_CPP_VERSION": "20260817.0",
      "ALPINE_VERSION": "3.23.8",
      "HAPROXY_OTEL_ADDON_VERSION": "2.3.0",
      "HAPROXY_OTEL_C_WRAPPER_VERSION": "3.4.0",
      "HAPROXY_VERSION": "3.4.8",
      "HAPROXY_VERSION_SERIES": "3.4",
      "NLOHMANN_JSON_VERSION": "3.12.0",
      "OPENTELEMETRY_CPP_VERSION": "1.30.0",
      "OPENTELEMETRY_PROTO_VERSION": "1.11.1",
      "PROTOBUF_VERSION": "36.2",
      "RAPIDYAML_VERSION": "0.16.0",
      "CENTOS_VERSION": "7.9.2009",
      "UBI10_MINIMAL_VERSION": "10.3-1795002774"
    },
    "downloads": [
      {
        "url": "https://www.haproxy.org/download/{HAPROXY_VERSION_SERIES}/src/haproxy-{HAPROXY_VERSION}.tar.gz",
        "name": "haproxy-{HAPROXY_VERSION}.tar.gz"
      },
      {
        "url": "https://github.com/haproxytech/opentelemetry-c-wrapper/archive/refs/tags/v{HAPROXY_OTEL_C_WRAPPER_VERSION}.tar.gz",
        "name": "opentelemetry-c-wrapper-{HAPROXY_OTEL_C_WRAPPER_VERSION}.tar.gz"
      },
      {
        "url": "https://github.com/haproxytech/haproxy-opentelemetry/archive/refs/tags/v{HAPROXY_OTEL_ADDON_VERSION}.tar.gz",
        "name": "haproxy-opentelemetry-{HAPROXY_OTEL_ADDON_VERSION}.tar.gz"
      },
      {
        "url": "https://github.com/abseil/abseil-cpp/archive/refs/tags/{ABSEIL_CPP_VERSION}.tar.gz",
        "name": "abseil-cpp-{ABSEIL_CPP_VERSION}.tar.gz"
      },
      {
        "url": "https://github.com/protocolbuffers/protobuf/archive/refs/tags/v{PROTOBUF_VERSION}.tar.gz",
        "name": "protobuf-{PROTOBUF_VERSION}.tar.gz"
      },
      {
        "url": "https://github.com/biojppm/rapidyaml/releases/download/v{RAPIDYAML_VERSION}/rapidyaml.v{RAPIDYAML_VERSION}.src.tgz",
        "name": "rapidyaml-{RAPIDYAML_VERSION}-src.tgz"
      },
      {
        "url": "https://github.com/nlohmann/json/archive/refs/tags/v{NLOHMANN_JSON_VERSION}.tar.gz",
        "name": "nlohmann-json-{NLOHMANN_JSON_VERSION}.tar.gz"
      },
      {
        "url": "https://github.com/open-telemetry/opentelemetry-cpp/archive/refs/tags/v{OPENTELEMETRY_CPP_VERSION}.tar.gz",
        "name": "opentelemetry-cpp-{OPENTELEMETRY_CPP_VERSION}.tar.gz"
      },
      {
        "url": "https://github.com/open-telemetry/opentelemetry-proto/archive/refs/tags/v{OPENTELEMETRY_PROTO_VERSION}.tar.gz",
        "name": "opentelemetry-proto-{OPENTELEMETRY_PROTO_VERSION}.tar.gz"
      }
    ],
    "version_env_var": "HAPROXY_VERSION"
  },
