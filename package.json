{
  "name": "static-builds",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "run-p check:*",
    "check:fences": "rumdl check --enable MD046 --no-cache --respect-gitignore .",
    "check:lint-rules": "node --test rules/*.test.ts",
    "check:links": "lychee --config .lychee.toml '**/*.md'",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:shellcheck": "make lint",
    "check:shfmt": "make shfmt-check",
    "check:typescript": "tsc --noEmit",
    "check:ultracite": "ultracite check --type-aware",
    "fix": "run-p fix:*",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:shfmt": "make shfmt-write",
    "fix:ultracite": "ultracite fix",
    "pre-commit": "run-s check",
    "pre-push": "run-s check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@oxc-project/types": "catalog:",
    "@tsconfig/node-lts": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "markdown-it": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-rule-search-replace": "catalog:",
    "njs-types": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "engines": {
    "node": "^26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
