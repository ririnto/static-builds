{
  "name": "static-builds",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "run-s \"download {1}\" \"build:compile {@} --output type=local,dest=dist/{1}\" \"build:package {1} release --clean --snapshot --verbose --timeout=6h --skip=publish,validate\" --",
    "build:compile": "go tool task build --",
    "build:package": "go tool task goreleaser --",
    "check": "run-p check:*",
    "check:formal-verification": "pnpm --filter @static-builds/formal-verification run check",
    "check:go-mod": "go tool task tidy -- -diff",
    "check:golangci-lint": "go tool task golangci-lint -- run ./...",
    "check:jsonnetfmt": "go tool task jsonnetfmt -- --test",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:nilaway": "go tool task nilaway -- ./...",
    "check:shfmt": "go tool task shfmt -- -d",
    "check:test": "go tool task test",
    "check:test-workflow-input-defaults": "node --test tests/workflow-input-defaults.test.ts",
    "check:typescript": "tsc --noEmit",
    "check:ultracite": "ultracite check",
    "check:workflow-input-defaults": "node rules/workflow-input-defaults.ts",
    "download": "go tool task download --",
    "fix": "run-p fix:*",
    "fix:formal-verification": "pnpm --filter @static-builds/formal-verification run fix",
    "fix:jsonnetfmt": "go tool task jsonnetfmt -- -i",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:shfmt": "go tool task shfmt -- -w",
    "fix:ultracite": "ultracite fix",
    "generate": "run-p generate:*",
    "generate:formal-verification": "pnpm --filter @static-builds/formal-verification run generate",
    "pre-commit": "run-s check",
    "pre-push": "run-s check",
    "prepare": "husky",
    "tasks": "go tool task"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@tsconfig/node-lts": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": "^24.22.3"
  },
  "packageManager": "pnpm@12.21.0"
}
