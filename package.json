{
  "name": "static-builds",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "go tool task build",
    "check": "run-p check:*",
    "check:go": "go test ./...",
    "check:golangci-lint": "go tool task golangci-lint -- run ./...",
    "check:jsonnet": "go tool jsonnet -S --ext-str branch=main --ext-str target= --ext-str component_ref=example.invalid/group/static-builds/static-release@main .gitlab/ci/package-pipeline.gitlab-ci.jsonnet && go tool jsonnet -S --ext-str branch=feature/tooling-check --ext-str target= --ext-str component_ref=example.invalid/group/static-builds/static-release@feature/tooling-check .gitlab/ci/package-pipeline.gitlab-ci.jsonnet",
    "check:jsonnetfmt": "go tool task jsonnetfmt -- --test",
    "check:lint-rules": "node --test rules/*.test.ts",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:shfmt": "go tool task shfmt -- -d -i 2 -ci",
    "check:typescript": "tsc --noEmit",
    "check:ultracite": "ultracite check --type-aware",
    "download": "go tool task download",
    "fix": "run-p fix:*",
    "fix:jsonnetfmt": "go tool task jsonnetfmt -- -i",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:shfmt": "go tool task shfmt -- -w -i 2 -ci",
    "fix:ultracite": "ultracite fix",
    "pre-commit": "run-s check",
    "pre-push": "run-s check",
    "prepare": "husky",
    "tasks": "go tool task"
  },
  "devDependencies": {
    "@oxc-project/types": "catalog:",
    "@tsconfig/node-lts": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "markdown-it": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "njs-types": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tla-chaos-loop": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "engines": {
    "node": "^26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
