{
  "name": "static-builds",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "go tool task build",
    "check": "run-p check:*",
    "check:go": "go tool task test-go",
    "check:fences": "rumdl check --enable MD046 --no-cache --respect-gitignore .",
    "check:jsonnet": "go tool task jsonnet-check",
    "check:jsonnetfmt": "go tool task jsonnetfmt-check",
    "check:links": "lychee --config .lychee.toml '**/*.md'",
    "check:lint-rules": "node --test rules/*.test.ts",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:typescript": "tsc --noEmit",
    "check:ultracite": "ultracite check --type-aware",
    "download": "go tool task download",
    "fix": "run-p fix:*",
    "fix:jsonnetfmt": "go tool task jsonnetfmt-write",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:ultracite": "ultracite fix",
    "list-targets": "go tool task list-targets",
    "pre-commit": "run-s check",
    "pre-push": "run-s check",
    "prepare": "husky",
    "tasks": "go tool task"
  },
  "devDependencies": {
    "@oxc-project/types": "catalog:",
    "@tsconfig/node-lts": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "markdown-it": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "njs-types": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tla-chaos-loop": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "engines": {
    "node": "^26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
